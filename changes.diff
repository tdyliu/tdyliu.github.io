+
+.wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }
+.skip { position: absolute; left: -999px; background: var(--accent); color: var(--on-accent); padding: .5rem 1rem; z-index: 200; }
+.skip:focus { left: 0; }
+
+/* header */
+.site-header { position: sticky; top: 0; z-index: 100; background: var(--bg); border-bottom: 1px solid var(--line); }
+.bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem; min-height: 4rem; }
+.brand { font: 600 1.25rem var(--serif); color: var(--ink); text-decoration: none; }
+nav { display: flex; align-items: center; flex-wrap: wrap; gap: .25rem 1.5rem; }
+nav a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: .95rem; }
+nav a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
+#theme-toggle { font: 500 .85rem var(--sans); color: var(--ink); background: none; border: 1px solid var(--line); border-radius: 4px; padding: .3rem .7rem; cursor: pointer; }
+#theme-toggle:hover { border-color: var(--accent); }
+
+/* type */
+h1 { font: 700 clamp(2.75rem, 7vw, 4.5rem)/1.05 var(--serif); letter-spacing: -.02em; }
+h2 { font: 600 1.9rem/1.2 var(--serif); margin-bottom: 2rem; }
+h3 { font: 600 1.15rem/1.35 var(--sans); }
+.role { font-size: 1.25rem; font-weight: 500; margin: .75rem 0 1.25rem; }
+.lead { color: var(--muted); max-width: 60ch; }
+ul { padding-left: 1.15rem; }
+li { margin-top: .5rem; max-width: 70ch; }
+
+/* sections */
+section { padding: 4.5rem 0; }
+.alt { background: var(--surface); border-block: 1px solid var(--line); }
+
+/* hero */
+.hero { padding: 4.5rem 0 5rem; }
+.hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 3.5rem; align-items: start; }
+.actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
+.btn { display: inline-block; padding: .65rem 1.2rem; border: 1.5px solid var(--accent); border-radius: 4px; color: var(--accent); font-weight: 500; text-decoration: none; }
+.btn:hover { background: var(--surface); }
+.btn.primary { background: var(--accent); color: var(--on-accent); }
+.btn.primary:hover { opacity: .88; }
+
+/* title block, like the corner of an engineering drawing */
+.titleblock { border: 2px solid var(--ink); background: var(--bg); }
+.titleblock div { display: grid; grid-template-columns: 7.5rem 1fr; border-top: 1px solid var(--line); }
+.titleblock div:first-child { border-top: 0; }
+.titleblock dt, .titleblock dd { padding: .8rem 1rem; }
+.titleblock dt { color: var(--muted); font-size: .9rem; border-right: 1px solid var(--line); }
+.titleblock dd { font-weight: 500; }
+
+/* experience */
+.job { display: grid; grid-template-columns: 13rem 1fr; gap: 2rem; padding: 2rem 0; border-top: 1px solid var(--line); }
+.job:last-child { border-bottom: 1px solid var(--line); }
+.when { color: var(--muted); font-size: .95rem; padding-top: .15rem; }
+
+/* projects */
+.projects { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
+.projects article { background: var(--bg); border: 1px solid var(--line); border-top: 4px solid var(--accent); border-radius: 2px; padding: 1.5rem; }
+.projects article:first-child { grid-column: 1 / -1; }
+.meta { color: var(--muted); font-size: .92rem; margin: .25rem 0 .5rem; }
+
+/* skills */
+.skills { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 3rem; }
+.skills dt { font-weight: 600; padding-bottom: .5rem; margin-bottom: .5rem; border-bottom: 2px solid var(--accent); }
+.skills dd { color: var(--muted); }
+
+footer { padding: 2rem 0; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
+
+@media (max-width: 800px) {
+  .hero-grid, .projects, .skills { grid-template-columns: 1fr; }
+  .hero-grid { gap: 2.5rem; }
+  .job { grid-template-columns: 1fr; gap: .5rem; }
+  .titleblock div { grid-template-columns: 6.5rem 1fr; }
+  section { padding: 3.5rem 0; }
 }
